<http://teresia.es/terminologia_juridico_administrativa_multilingue/terminologia_juridico_administrativa_C1_es_Definition>
  a termlex:Definition;
  dct:language <http://lexvo.org/id/iso639-3/spa>;
  rdfs:label "Actuación formal de una administración pública que produce efectos jurídicos sobre una persona, entidad o situación concreta."@es .

<http://teresia.es/terminologia_juridico_administrativa_multilingue/terminologia_juridico_administrativa_C1_en_Definition>
  a termlex:Definition;
  dct:language <http://lexvo.org/id/iso639-3/eng>;
  rdfs:label "Formal action by a public administration that produces legal effects on a person, entity or specific situation."@en .

<http://teresia.es/terminologia_juridico_administrativa_multilingue/terminologia_juridico_administrativa_C1_ca_Definition>
  a termlex:Definition;
  dct:language <http://lexvo.org/id/iso639-3/cat>;
