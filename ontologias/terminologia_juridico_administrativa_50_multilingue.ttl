<http://teresia.es/terminologia_juridico_administrativa_multilingue/terminologia_juridico_administrativa_C1_gl_Definition>
  a termlex:Definition;
  dct:language <http://lexvo.org/id/iso639-3/glg>;
  rdfs:label "Actuación formal dunha administración pública que produce efectos xurídicos sobre unha persoa, entidade ou situación concreta."@gl .

