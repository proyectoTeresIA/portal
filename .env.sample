# Database Configuration
MYSQL_USER=bp_user
MYSQL_PASSWORD=changeme
DB_HOST=db

# Rails Configuration
RAILS_ENV=development
NODE_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here
# Obtenida de ejecutar el script create_admin_user.rb
# Cada vez que se reinicie la base de datos, este valor debe ser actualizado
API_KEY=your_api_key_here

# Debug Configuration
UI_URL=http://localhost

# API Configuration
# Watch out for the trailing slashes! Keep them as they are here.
API_URL=http://api:9393
EXTERNAL_API_URL=http://localhost/api
REST_URL_PREFIX=http://api:9393/
RACK_ENV=development
ADMIN_PASSWORD=admin123 # Cambiar en producción

# Ruby Configuration
RUBY_VERSION=3.1.6

# Bundle Configuration
BUNDLE_PATH=/srv/ontoportal/bundle
BUNDLE_APP_CONFIG=/srv/ontoportal/bundle
BUNDLE_WITHOUT=production:test
FRONTEND_BUNDLE_PATH=/usr/local/bundle

# Development Configuration
COVERAGE=false
OVERRIDE_CONFIG=false

# Redis Configuration
REDIS_HOST=redis-api
REDIS_PORT=6379
GOO_REDIS_HOST=redis-api
REDIS_GOO_CACHE_HOST=redis-api
REDIS_HTTP_CACHE_HOST=redis-api
REDIS_PERSISTENT_HOST=redis-api
ANNOTATOR_REDIS_HOST=redis-api
ANNOTATOR_REDIS_PORT=6379

# Solr Configuration
SOLR_TERM_SEARCH_URL=http://solr-api:8983/solr/term_search_core1
SOLR_PROP_SEARCH_URL=http://solr-api:8983/solr/prop_search_core1

# MGREP Configuration
MGREP_HOST=mgrep-ut
MGREP_PORT=55556

# BioMixer Configuration
BIOMIXER_URL=https://biomixer.bioontology.org

# 4store Configuration
GOO_BACKEND_NAME=4store
GOO_HOST=4store-api
GOO_PORT=9000
GOO_PATH_QUERY=/sparql/
GOO_PATH_DATA=/data/
GOO_PATH_UPDATE=/update/

# Memcache Configuration
MEMCACHE_SERVERS=memcache-frontend:11211

# Port Configuration
API_PORT=9393
FRONTEND_PORT=3000
REDIS_PORT_EXTERNAL=6379
FOURSTORE_PORT_EXTERNAL=9000
SOLR_PORT_EXTERNAL=8983
MYSQL_PORT_EXTERNAL=3306
MEMCACHE_PORT_EXTERNAL=11211